    <!-- JavaScript Logic -->
    <script>
        // Default vote numbers simulation
        let votes = [112, 86, 50]; // Venue A, Venue B, Venue C initial counts
        const storageKey = 'nursing_venue_votes_v2';
        const userVotedKey = 'nursing_user_voted_choice';

        // Initialize state on window load
        window.onload = function() {
            loadVotes();
            updateVoteUI();

            // Mobile menu toggle listeners
            const mobileBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            
            mobileBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            // Close mobile menu when clicking a link
            document.querySelectorAll('.mobile-link').forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                });
            });
        };

        // Load persisted votes from localStorage
        function loadVotes() {
            const savedVotes = localStorage.getItem(storageKey);
            if (savedVotes) {
                try {
                    votes = JSON.parse(savedVotes);
                } catch(e) {
                    console.error('Error parsing stored votes', e);
                }
            }
        }

        // Save votes to localStorage
        function saveVotes() {
            localStorage.setItem(storageKey, JSON.stringify(votes));
        }

        // Render current vote statistics and progress bars
        function updateVoteUI() {
            const totalVotes = votes.reduce((a, b) => a + b, 0);
            
            // Update total in Hero banner
            document.getElementById('hero-vote-count').innerText = totalVotes;

            const userChoice = localStorage.getItem(userVotedKey);

            votes.forEach((count, idx) => {
                const percent = totalVotes > 0 ? Math.round((count / totalVotes) * 100) : 0;
                
                // Update text counter
                const countElem = document.getElementById(`v-count-${idx}`);
                if (countElem) {
                    countElem.innerText = `${count} 票 (${percent}%)`;
                }

                // Update width bar
                const barElem = document.getElementById(`v-bar-${idx}`);
                if (barElem) {
                    barElem.style.width = `${percent}%`;
                }

                // Update Button styling if user voted for this item
                const btnElem = document.getElementById(`v-btn-${idx}`);
                if (btnElem) {
                    if (userChoice !== null && parseInt(userChoice) === idx) {
                        btnElem.classList.add('bg-slate-800', 'text-white', 'border-transparent');
                        btnElem.classList.remove('bg-sky-50', 'bg-pink-50', 'bg-emerald-50');
                        btnElem.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400"></i><span>您已投票此場地</span>`;
                    } else {
                        btnElem.classList.remove('bg-slate-800', 'text-white');
                        btnElem.innerHTML = `<i class="fa-solid fa-thumbs-up"></i><span>為此場地投票</span>`;
                    }
                }
            });
        }

        // Cast or change vote logic
        function castVote(venueIndex) {
            const previousVote = localStorage.getItem(userVotedKey);

            if (previousVote !== null) {
                const prevIdx = parseInt(previousVote);
                if (prevIdx === venueIndex) {
                    // Clicking same button again
                    alert('您已經為此場地投過票囉！');
                    return;
                } else {
                    // Changing vote option
                    votes[prevIdx] = Math.max(0, votes[prevIdx] - 1);
                }
            }

            // Apply new vote
            votes[venueIndex]++;
            localStorage.setItem(userVotedKey, venueIndex);
            saveVotes();
            updateVoteUI();
        }

        // Reset vote option for testing
        function resetVote() {
            const previousVote = localStorage.getItem(userVotedKey);
            if (previousVote !== null) {
                const prevIdx = parseInt(previousVote);
                votes[prevIdx] = Math.max(0, votes[prevIdx] - 1);
                localStorage.removeItem(userVotedKey);
                saveVotes();
                updateVoteUI();
                alert('已重設您的投票狀態！您可以重新選擇場地。');
            } else {
                alert('您目前尚未投票喔！');
            }
        }

        // FAQ Accordion Toggle
        function toggleFaq(index) {
            const ansElem = document.getElementById(`faq-ans-${index}`);
            const iconElem = document.getElementById(`faq-icon-${index}`);
            
            if (ansElem.classList.contains('hidden')) {
                ansElem.classList.remove('hidden');
                iconElem.classList.add('rotate-180');
            } else {
                ansElem.classList.add('hidden');
                iconElem.classList.remove('rotate-180');
            }
        }

        // Handle Registration Form Submit
        function handleRegistration(e) {
            e.preventDefault();
            const name = document.getElementById('student-name').value;
            const grade = document.getElementById('student-grade').value;

            document.getElementById('modal-desc').innerText = `親愛的 ${name} 同學（${grade}），我們已收到您的報名資料！系學會將盡快向您核對活動細節。`;

            // Open Modal
            const modal = document.getElementById('successModal');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.querySelector('div').classList.remove('scale-95');
                modal.querySelector('div').classList.add('scale-100');
            }, 10);

            // Reset Form
            document.getElementById('regForm').reset();
        }

        // Close Modal Dialog
        function closeModal() {
            const modal = document.getElementById('successModal');
            modal.classList.add('opacity-0');
            modal.querySelector('div').classList.remove('scale-100');
            modal.querySelector('div').classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }
    </script>
